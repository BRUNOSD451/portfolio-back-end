# Banco: use DATABASE_URL (nuvem) ou os campos DB_* (MySQL local).
# TiDB Cloud: mysql://USUARIO:SENHA@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/portfolio?sslaccept=strict
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

PORT=3000
# Em produção: origens exatas do site/app, separadas por vírgula.
# CORS_ORIGINS=https://seu-site.vercel.app,http://localhost:8081
# Atrás de um proxy (Render): 1
# TRUSTED_PROXY=1

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Chave que o servidor do agente de IA envia no cabeçalho X-Api-Key ao gravar
# mensagens em POST /messages/create (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MESSAGES_API_KEY=
