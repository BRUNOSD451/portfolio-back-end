generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tecnologias {
  id     Int     @id @default(autoincrement())
  nome   String  @unique @db.VarChar(100)
  imagem String? @db.VarChar(2048)
}

model projetos {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(150)
  descricao String?   @db.Text
  criado_em DateTime? @default(now()) @db.Timestamp(0)
}

model projeto_tecnologias {
  projeto_id    Int
  tecnologia_id Int

  @@id([projeto_id, tecnologia_id])
}

enum projeto_midias_tipo {
  imagem
  video
}

model projeto_midias {
  id         Int                 @id @default(autoincrement())
  projeto_id Int
  tipo       projeto_midias_tipo
  url        String              @db.VarChar(2048)
  ordem      Int?                @default(0)
  criado_em  DateTime?           @default(now()) @db.Timestamp(0)
}

model user {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(100)
  idade     Int?
  email     String    @unique @db.VarChar(150)
  telefone  String?   @db.VarChar(20)
  curriculo String?   @db.VarChar(2048)
  imageUrl  String?   @db.VarChar(2048)
  descricao String?   @db.Text
  criado_em DateTime? @default(now()) @db.Timestamp(0)
}

// Conta administrativa, sessões e cota de upload. Ficam no MySQL para
// sobreviver aos reinícios de hospedagens com disco temporário.
model admin_conta {
  id    Int    @id
  email String @db.VarChar(150)
  salt  String @db.Char(32)
  hash  String @db.Char(128)
}

model admin_sessoes {
  digest    String @id @db.Char(64)
  expira_em BigInt
  criado_em BigInt

  @@index([criado_em])
}

model upload_cota {
  dia   String @id @db.Char(10)
  bytes BigInt
}

// PDF do currículo do proprietário (único registro, id 1).
model curriculo_arquivo {
  id            Int      @id
  conteudo      Bytes    @db.MediumBlob
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

// Mensagens que recrutadores enviam ao agente de IA (gravadas pelo servidor do agente).
model messages {
  id        Int      @id @default(autoincrement())
  sessao    String?  @db.VarChar(100)
  conteudo  String   @db.Text
  criado_em DateTime @default(now()) @db.Timestamp(0)

  @@index([sessao])
  @@index([criado_em])
}
